<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.hammerhall</groupId>
    <artifactId>hammerhall-cli</artifactId>
    <version>0.1.1</version>
    <packaging>jar</packaging>

    <name>Hammerhall CLI</name>
    <description>Клиент кузницы: отправка решений и профиль</description>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!--
        В ПОСТАВКЕ ЗАВИСИМОСТЕЙ НЕТ, и это требование, а не совпадение.

        Клиент качается обёрткой при первом запуске в кузнице пользователя.
        Каждая библиотека — это мегабайты в загрузке и ещё одна вещь,
        которую надо обновлять при уязвимостях. HTTP берём из JDK
        (java.net.http), JSON читаем сами: разбираем ответы, которые
        сами же и формируем на сервере.

        ⚠️ Ниже есть зависимости со scope=test — они в jar НЕ попадают
        и правилу не противоречат. Тестовый инструмент нужен: до 23.07
        клиент был единственным модулем проекта без единой проверки,
        при том что именно его видит человек и именно он ломается первым
        при смене контракта API.

        Java 25 — та же, что в кузнице и на платформе. Занижать планку
        не от чего: пользователь клонирует кузницу, которая собирается
        на 25, значит эта JDK у него уже стоит. Единая версия во всех трёх
        репозиториях избавляет от вопросов совместимости заранее.
    -->

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>5.11.4</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Только для тестов. В cli-0.1.1.jar не едет. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.7</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>cli-${project.version}</finalName>
        <plugins>
            <!--
                Версия закреплена сознательно: дефолтная из super-POM зависит
                от версии Maven, и старые (3.1 и раньше) не понимают
                maven.compiler.release — молча берут source 5 и падают.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <!--
                ⚠️ Версию surefire ОБЯЗАТЕЛЬНО закреплять. Дефолт из super-POM —
                2.12.4, он старше JUnit 5 и молча не находит ни одного теста:
                сборка зелёная, проверок ноль. Ровно та ловушка, из-за которой
                на платформе *IT не запускались под Maven и там накопился
                боевой баг. Версия та же, что на платформе.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
                <configuration>
                    <!--
                        Кодировка вывода форкнутой JVM: без этого русские
                        @DisplayName и сообщения тестов приезжают кашей.
                        .mvn/jvm.config чинит только JVM самого Maven —
                        тесты идут в отдельном процессе, и ему надо сказать
                        отдельно.

                        ⚠️ @{argLine} обязателен. JaCoCo кладёт свой агент
                        именно в свойство argLine, и простой <argLine> его
                        затрёт — покрытие молча станет пустым, а сборка
                        останется зелёной. Собачка означает «подставить
                        значение на момент запуска», то есть агент выживет.
                    -->
                    <argLine>@{argLine} -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8</argLine>
                </configuration>
            </plugin>

            <!--
                Покрытие: target/site/jacoco/index.html после `mvn test`.
                Версия как на платформе — старые JaCoCo спотыкаются об
                инструментирование байткода новых JDK. Порог не включён:
                сначала набираем покрытие, потом фиксируем планку.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>io.hammerhall.cli.Main</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>